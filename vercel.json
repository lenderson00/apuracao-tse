{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/tse/oficial/ele2026/:path*",
      "destination": "https://resultados.tse.jus.br/oficial/ele2026/:path*"
    },
    {
      "source": "/api/tse/oficial/comum/config/:path*",
      "destination": "https://resultados.tse.jus.br/oficial/comum/config/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/tse/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=30, stale-while-revalidate=60" },
        { "key": "Cache-Control", "value": "public, max-age=15" }
      ]
    }
  ]
}
