{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/presenca/agora.csv",
      "destination": "https://apuracao-presenca.plugandship.workers.dev/agora"
    },
    {
      "source": "/api/tse/oficial/ele2026/:path*",
      "destination": "https://resultados.tse.jus.br/oficial/ele2026/:path*"
    },
    {
      "source": "/api/tse/oficial/comum/config/:path*",
      "destination": "https://resultados.tse.jus.br/oficial/comum/config/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/presenca/agora.csv",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=10, stale-if-error=60"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=10"
        }
      ]
    },
    {
      "source": "/api/tse/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600, stale-if-error=3600"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=30"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/:ele(6257|6259)/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800, stale-if-error=604800"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/arquivo-urna/3220/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800, stale-if-error=604800"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/:ele(6258|6260)/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=600, stale-if-error=3600"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=30"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/comum/config/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=21600, stale-while-revalidate=86400, stale-if-error=604800"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/:ele(\\d+)/config/:file",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=21600, stale-while-revalidate=86400, stale-if-error=604800"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/arquivo-urna/3221/config/:uf/:file",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=600, stale-if-error=3600"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/api/tse/oficial/ele2026/arquivo-urna/:pleito/dados/:uf/:mun/:zona/:secao/:hash/:file",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
